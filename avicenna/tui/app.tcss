/* Avicenna TUI — Cline-style harness with neon green accent */

/* Color definitions (neon green accent) */

/* Root layout */
#body {
    layout: horizontal;
    height: 1fr;
}

/* Left panel: compact status sidebar */
#meta {
    width: 30;
    min-width: 30;
    border-right: tall $accent-darken-2;
    padding: 0 1;
    background: $surface;
}

/* Right panel: chat (ChatView is RichLog) */
#chat {
    width: 1fr;
    background: $surface-darken-1;
}

/* Input bar at bottom */
#chat-input {
    dock: bottom;
    border-top: tall $accent-darken-2;
    padding: 0 1;
    height: 3;
    background: $surface;
}

/* Vault card */
#vault-card {
    border: round $accent-darken-1;
    padding: 0 1;
    margin-bottom: 1;
    background: $surface-darken-1;
    height: 5;
}

/* Pipeline tracker */
#pipeline-tracker {
    border: round $accent-darken-1;
    padding: 0 1;
    margin-bottom: 1;
    background: $surface-darken-1;
    height: 3;
}

/* Heading grid */
#heading-grid {
    height: 1fr;
    min-height: 4;
    border: round $accent-darken-1;
    margin-bottom: 1;
}

/* Stats bar */
#stats-bar {
    border: round $accent-darken-1;
    padding: 0 1;
    background: $surface-darken-1;
    height: 3;
}

/* Header */
Header {
    background: $surface-darken-2;
    color: $accent;
    text-style: bold;
}

/* Footer */
Footer {
    background: $surface-darken-2;
    color: $text-muted;
}

/* Input styling */
Input {
    background: $surface-darken-1;
    border: tall $accent-darken-1;
    color: $text;
}

Input:focus {
    border: tall $accent;
    background: $surface;
}

/* DataTable styling */
DataTable {
    background: $surface-darken-1;
}

DataTable > .datatable--header {
    background: $surface-darken-2;
    color: $accent;
    text-style: bold;
}

DataTable > .datatable--row {
    background: $surface-darken-1;
}

DataTable > .datatable--row:hover {
    background: $surface;
}
