/* Avicenna TUI — modern cockpit theme */

/* Root layout */
#body {
    layout: horizontal;
    height: 1fr;
}

/* Left panel: metadata */
#meta {
    width: 38%;
    min-width: 40;
    border-right: heavy $primary-darken-2;
    padding: 0 1;
    background: $surface;
}

/* Right panel: chat (ChatView is RichLog) */
#chat {
    width: 1fr;
    background: $surface-darken-1;
}

/* Input bar at bottom */
#chat-input {
    dock: bottom;
    border-top: heavy $primary-darken-2;
    padding: 0 1;
    background: $surface;
}

/* Vault card */
#vault-card {
    border: round $primary-darken-1;
    padding: 0 1;
    margin-bottom: 1;
    background: $surface-darken-1;
    height: 7;
}

/* Pipeline tracker */
#pipeline-tracker {
    border: round $primary-darken-1;
    padding: 0 1;
    margin-bottom: 1;
    background: $surface-darken-1;
    height: 3;
}

/* Heading grid */
#heading-grid {
    height: 1fr;
    min-height: 4;
    border: round $primary-darken-1;
    margin-bottom: 1;
}

/* Stats bar */
#stats-bar {
    border: round $primary-darken-1;
    padding: 0 1;
    background: $surface-darken-1;
    height: 3;
}

/* Header */
Header {
    background: $primary-darken-2;
}

/* Footer */
Footer {
    background: $primary-darken-2;
}
