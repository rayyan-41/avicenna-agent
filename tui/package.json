{
  "name": "avicenna-tui",
  "version": "3.0.0",
  "private": true,
  "description": "Terminal frontend for the Avicenna agent harness",
  "type": "module",
  "main": "./src/index.tsx",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "bun build src/index.tsx --target=bun --outfile=dist/main.js",
    "test": "bun test",
    "start": "bun run src/index.tsx"
  },
  "dependencies": {
    "@opentui/core": "0.5.11",
    "@opentui/react": "0.5.11",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.3"
  }
}
